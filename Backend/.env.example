# Primary Gemini API Key (required)
GEMINI_API_KEY=your-gemini-key-here

# Additional Gemini API Keys for rate limit rotation (optional)
# Add 3-4 keys from different Google accounts to get 15 RPM × 4 = 60 RPM total
GEMINI_API_KEY_2=your-second-gemini-key-here
GEMINI_API_KEY_3=your-third-gemini-key-here
GEMINI_API_KEY_4=your-fourth-gemini-key-here

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite

# Azure Speech Services (TTS + STT)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_ENDPOINT=https://eastasia.api.cognitive.microsoft.com/
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=en-IN-KunalNeural

# Other API Keys (optional)
ANTHROPIC_API_KEY=your-key-here

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173
